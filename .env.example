PORT=8787

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

SUPABASE_URL=http://127.0.0.1:54321


# What this process serves: all (default) | api | sync. See README "Calendar integrations".
# SERVICE_ROLE=all

# Calendar integrations (src/calendars/env.ts). All optional until the steps that use them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32)
# CALENDAR_CREDENTIALS_KEY=
# Public HTTPS base for webhooks and OAuth callbacks (a cloudflared tunnel when local)
# CALENDAR_PUBLIC_URL=
# inline (default; jobs run in-process) | cloud-tasks
# CALENDAR_QUEUE=inline
# Cloud Tasks / Scheduler OIDC: who may call /jobs/calendar/*, and the audience they use
# CALENDAR_TASKS_QUEUE=projects/<project>/locations/<region>/queues/<name>
# CALENDAR_JOBS_INVOKER=
# CALENDAR_JOBS_URL=
# CALENDAR_PUSH_ENABLED=false
