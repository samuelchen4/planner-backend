# Copy to .env for `pnpm dev`. The defaults in src/env.ts already point at the local Supabase
# (`pnpm db:start`), so locally this file is optional.

PORT=8787

# Postgres, as a role that can `set role authenticated` (Supabase's `postgres` user).
# Cloud: the project's connection string (Session pooler or direct), from Secret Manager.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# The Supabase project URL. Its JWKS (/auth/v1/.well-known/jwks.json) verifies access tokens.
SUPABASE_URL=http://127.0.0.1:54321

# Only for projects still signing tokens with the legacy HS256 shared secret. Usually unset.
# SUPABASE_JWT_SECRET=
