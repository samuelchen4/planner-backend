{
  "name": "planner-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --target node22 --clean",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:generate": "drizzle-kit generate",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.17",
    "jose": "^6.2.17",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "supabase": "^3.1.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
